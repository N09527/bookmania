u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff14\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff14\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5746\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5751\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5756\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5761\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5766\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff16\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5766\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\"}"
"{\"src\":\"OEBPS/text/ch02.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":14,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":2,\"ms\":3501,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\"}],\"all\":\"\u7b2c\uff12\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff14\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5741\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff14\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff14\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5746\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5751\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5756\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5761\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5766\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\"}"
"{\"src\":\"OEBPS/text/ch02.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":16,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":2,\"ms\":3501,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"}],\"all\":\"\u7b2c\uff12\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff14\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5741\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff14\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff14\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5746\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5751\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5756\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5761\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5766\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"}"
"{\"src\":\"OEBPS/text/ch02.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":18,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":2,\"ms\":3501,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\"}],\"all\":\"\u7b2c\uff12\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff14\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5741\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff14\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff14\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5746\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5751\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5756\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5761\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5766\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\"}"
"{\"src\":\"OEBPS/text/ch02.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":20,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":2,\"ms\":3501,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"},{\"left\":12,\"width\":182,\"hidden\":true,\"vis\":\"\"}],\"all\":\"\u7b2c\uff12\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff14\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5741\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff14\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff14\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5746\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff14\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff14\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff14\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5751\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff15\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff15\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5756\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff15\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff15\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff15\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5761\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff16\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff16\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5766\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff16\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff16\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff16\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5771\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff17\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff17\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5776\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff17\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff17\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff17\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff18\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"}"
"{\"src\":\"OEBPS/text/ch03.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":0,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":3,\"ms\":7087,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\"}],\"all\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57106\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57111\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57116\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff12\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\"}"
"{\"src\":\"OEBPS/text/ch03.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":2,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":3,\"ms\":7087,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\"}],\"all\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57106\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57111\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57116\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff12\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\"}"
"{\"src\":\"OEBPS/text/ch03.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":4,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":3,\"ms\":7087,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\"}],\"all\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57106\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57111\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57116\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff12\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\"}"
"{\"src\":\"OEBPS/text/ch03.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":6,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":3,\"ms\":7087,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"}],\"all\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57106\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57111\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57116\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff12\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\"}"
"{\"src\":\"OEBPS/text/ch03.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":8,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":3,\"ms\":7087,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\"}],\"all\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57106\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57111\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57116\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff12\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\"}"
"{\"src\":\"OEBPS/text/ch03.xhtml\",\"st\":{\"ready\":true,\"error\":null,\"page\":10,\"pages\":21,\"cols\":2,\"mode\":\"V\",\"seq\":3,\"ms\":7087,\"rubyFix\":true},\"frames\":[{\"left\":218,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\"},{\"left\":12,\"width\":182,\"hidden\":false,\"vis\":\"\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\"}],\"all\":\"\u7b2c\uff13\u7ae0\u6e2c\u8a66\u7ae0\u7bc0\u3010\u7b2c\uff18\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5781\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff18\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff18\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5786\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff18\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff18\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff18\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5791\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff19\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff19\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b5796\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff19\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff19\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff19\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff10\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57106\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff10\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57111\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff14\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff11\uff15\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff11\uff16\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57116\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff11\uff17\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff11\uff18\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\u3010\u7b2c\uff11\uff11\uff19\u6bb5\u3011\u77ed\u6bb5\u843d\u3002\u3010\u7b2c\uff11\uff12\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\",\"vis\":\"\u3010\u7b2c\uff11\uff10\uff10\u6bb5\u3011\u9019\u662f\u4e00\u6bb5\u7528\u4f86\u6e2c\u8a66\u7684\u6587\u5b57\uff0c\u5305\u542b\u300c\u5f15\u865f\u300d\u3001\u300e\u96d9\u5f15\u865f\u300f\u3001\uff08\u62ec\u865f\uff09\u8207\u5168\u5f62\u6a19\u9ede\uff1a\u9017\u865f\uff0c\u53e5\u865f\u3002\u9a5a\u5606\u865f\uff01\u554f\u865f\uff1f\u3010\u7b2c\uff11\uff10\uff11\u6bb5\u3011\u82f1\u6587\u55ae\u5b57WebView\u8207\u963f\u62c9\u4f2f\u6578\u5b57101\u6df7\u5728\u5176\u4e2d\uff1b\u5e74\u4efd\u5beb\u6210\u4e8c\u3007\u4e8c\u516d\u5e74\uff1b\u7701\u7565\u865f\u2026\u2026\u8207\u7834\u6298\u865f\u2014\u2014\u4e5f\u8981\u6aa2\u67e5\u3002\u3010\u7b2c\uff11\uff10\uff12\u6bb5\u3011\u6f22\u5b57\u53ef\u4ee5\u52a0\u4e0a\u6ce8\u97f3\uff1b\u65e5\u671f12\u670831\u65e5\u4f7f\u7528\u7e31\u4e2d\u6a6b\u3002\u3010\u7b2c\uff11\uff10\uff13\u6bb5\u3011\u9577\u4e00\u9ede\u7684\u6bb5\u843d\uff1a\u95b1\u8b80\u7a0b\u5f0f\u9700\u8981\u4f9d\u7167\u4f7f\u7528\u8005\u7684\u8a2d\u5b9a\u8abf\u6574\u5b57\u7d1a\u3001\u884c\u8ddd\u3001\u5b57\u8ddd\u3001\u9996\u884c\u7e2e\u6392\u8207\u6bb5\u843d\u9593\u8ddd\uff0c\u4e26\u4e14\u5728\u76f4\u66f8\u8207\u6a6b\u66f8\u4e4b\u9593\u5207\u63db\uff0c\u7ffb\u9801\u6642\u5167\u5bb9\u4e0d\u53ef\u7f3a\u6f0f\u4e5f\u4e0d\u53ef\u91cd\u8907\u3002\"}"
